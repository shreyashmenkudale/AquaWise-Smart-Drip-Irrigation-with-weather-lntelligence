#include <DHT.h>

// ================= PIN CONNECTIONS =================
// ESP32 GPIO23 -> Level shifter LV1 -> Level shifter HV1 -> Relay IN
// ESP32 3V3    -> Level shifter LV
// ESP32 VIN(5V)-> Level shifter HV and Relay VCC
// ESP32 GND    -> Level shifter GND (both sides) and Relay GND
#define SOIL_PIN   34   // Soil moisture sensor AO
#define DHT_PIN    4    // DHT11 DATA
#define RELAY_PIN  23   // Goes to level shifter LV1 (NOT directly to relay)
#define FLOW_PIN   27   // Flow sensor signal (used only if USE_FLOW_SENSOR = 1)

#define DHTTYPE DHT11

// Set to 1 ONLY when a flow sensor is really connected.
// With 1 and no sensor, the pump is stopped after 5 s by the "no flow" safety.
#define USE_FLOW_SENSOR 0

// The level shifter passes the signal through unchanged, so this is still
// the setting of your relay module:
// false = Active LOW  (LOW = relay ON, HIGH = relay OFF)  <- most blue modules
// true  = Active HIGH (HIGH = relay ON, LOW = relay OFF)
const bool RELAY_ACTIVE_HIGH = false;

const uint8_t RELAY_ON_LEVEL  = RELAY_ACTIVE_HIGH ? HIGH : LOW;
const uint8_t RELAY_OFF_LEVEL = RELAY_ACTIVE_HIGH ? LOW  : HIGH;

DHT dht(DHT_PIN, DHTTYPE);

// ================= SOIL CALIBRATION =================
const int DRY_ADC = 3000;
const int WET_ADC = 1400;

const int MOISTURE_LOW    = 30;
const int MOISTURE_TARGET = 60;
const int WET_LIMIT       = 80;

// ================= FLOW SENSOR =================
const float PULSES_PER_LITRE = 450.0;

volatile unsigned long flowPulses = 0;

float totalLitres = 0;
float flowRate = 0;
bool flowFault = false;

// ================= STATE =================
bool pumpOn = false;
bool automaticMode = false;   // starts in MANUAL: only ON / OFF control the relay

unsigned long pumpStartTime = 0;
unsigned long lastFlowCheck = 0;
unsigned long lastSensorRead = 0;

const unsigned long SENSOR_INTERVAL = 2000;
const unsigned long FLOW_INTERVAL   = 1000;
const unsigned long FLOW_TIMEOUT    = 10000;

// ================= SENSOR VALUES =================
int soilADC = 0;
int moisture = 0;
float temperature = 0;
float humidity = 0;
bool dhtValid = false;

#if USE_FLOW_SENSOR
void IRAM_ATTR countFlowPulse()
{
  flowPulses++;
}
#endif

// ================= RELAY / PUMP CONTROL =================
void setPump(bool state)
{
  if (state && flowFault)
  {
    Serial.println("FLOW FAULT! Type RESET first.");
    return;
  }

  pumpOn = state;

  // Always write the pin so the relay matches the command
  digitalWrite(RELAY_PIN, state ? RELAY_ON_LEVEL : RELAY_OFF_LEVEL);

  if (state)
  {
    pumpStartTime = millis();
    lastFlowCheck = millis();
    Serial.println("Relay ON - Pump ON");
  }
  else
  {
    Serial.println("Relay OFF - Pump OFF");
  }
}

// ================= STATUS PRINT =================
void printRelayInfo()
{
  Serial.print("Relay: ");
  Serial.print(pumpOn ? "ON" : "OFF");
  Serial.print("  (GPIO");
  Serial.print(RELAY_PIN);
  Serial.print(" = ");
  Serial.print(digitalRead(RELAY_PIN) ? "HIGH" : "LOW");
  Serial.print(", ");
  Serial.print(RELAY_ACTIVE_HIGH ? "active HIGH" : "active LOW");
  Serial.println(")");
}

void printSensorInfo()
{
  Serial.print("Soil ADC: ");
  Serial.println(soilADC);

  Serial.print("Soil Moisture: ");
  Serial.print(moisture);
  Serial.println("%");

  if (dhtValid)
  {
    Serial.print("Temperature: ");
    Serial.print(temperature);
    Serial.println(" C");

    Serial.print("Air Humidity: ");
    Serial.print(humidity);
    Serial.println("%");
  }
  else
  {
    Serial.println("DHT11: reading unavailable");
  }
}

void printStatus()
{
  Serial.println("\n----- SYSTEM STATUS -----");

  Serial.print("Mode: ");
  Serial.println(automaticMode ? "AUTO" : "MANUAL");

  printRelayInfo();

  if (pumpOn)
  {
    Serial.print("Pump running for: ");
    Serial.print((millis() - pumpStartTime) / 1000);
    Serial.println(" s");
  }

  printSensorInfo();

#if USE_FLOW_SENSOR
  Serial.print("Water Flow: ");
  Serial.print(flowRate);
  Serial.println(" L/min");

  Serial.print("Total Water Used: ");
  Serial.print(totalLitres, 3);
  Serial.println(" L");

  Serial.print("Flow Fault: ");
  Serial.println(flowFault ? "YES" : "NO");
#else
  Serial.println("Flow sensor: disabled");
#endif

  Serial.println("-------------------------");
}

// ================= SERIAL COMMANDS =================
void processCommand(String cmd)
{
  cmd.trim();
  cmd.toUpperCase();

  if (cmd == "ON")
  {
    automaticMode = false;
    Serial.println("Manual mode enabled.");
    setPump(true);
  }
  else if (cmd == "OFF")
  {
    automaticMode = false;
    setPump(false);
  }
  else if (cmd == "AUTO")
  {
    automaticMode = true;
    Serial.println("Automatic irrigation enabled.");
  }
  else if (cmd == "MANUAL")
  {
    automaticMode = false;
    Serial.println("Manual mode enabled.");
    Serial.println("Type ON or OFF to control the pump.");
  }
  else if (cmd == "STATUS")
  {
    printStatus();
  }
  else if (cmd == "RESET")
  {
    setPump(false);
    flowFault = false;

    noInterrupts();
    flowPulses = 0;
    interrupts();

    flowRate = 0;

    Serial.println("Flow fault cleared.");
    Serial.println("Pump remains OFF.");
  }
  else if (cmd == "HELP")
  {
    Serial.println("\nAvailable Commands:");
    Serial.println("ON     - Turn relay and pump ON");
    Serial.println("OFF    - Turn relay and pump OFF");
    Serial.println("AUTO   - Enable automatic irrigation");
    Serial.println("MANUAL - Enable manual control");
    Serial.println("STATUS - Display relay and sensor readings");
    Serial.println("RESET  - Clear flow fault");
    Serial.println("HELP   - Show commands");
  }
  else if (cmd.length() > 0)
  {
    Serial.println("Invalid command. Type HELP.");
  }
}

// ================= SETUP =================
void setup()
{
  // Relay pin: set OFF level first, then make it an output
  digitalWrite(RELAY_PIN, RELAY_OFF_LEVEL);
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, RELAY_OFF_LEVEL);

  Serial.begin(115200);

  pinMode(SOIL_PIN, INPUT);

#if USE_FLOW_SENSOR
  pinMode(FLOW_PIN, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(FLOW_PIN), countFlowPulse, RISING);
#endif

  dht.begin();
  analogReadResolution(12);

  automaticMode = false;
  pumpOn = false;

  Serial.println("\nSmart Drip Irrigation System");
  Serial.println("ESP32 started successfully.");
  Serial.println("Relay initially OFF (via level shifter on GPIO23).");
  Serial.println("Manual mode enabled.");
  Serial.println("Type ON / OFF to control the relay. Type HELP for commands.");
  Serial.println("(Serial Monitor: 115200 baud, line ending 'Newline')");
}

// ================= MAIN LOOP =================
void loop()
{
  unsigned long now = millis();

  // ---- Serial Monitor commands ----
  if (Serial.available() > 0)
  {
    String command = Serial.readStringUntil('\n');
    processCommand(command);
  }

  // ---- Sensors every 2 seconds ----
  if (now - lastSensorRead >= SENSOR_INTERVAL)
  {
    lastSensorRead = now;

    soilADC = analogRead(SOIL_PIN);
    moisture = map(soilADC, DRY_ADC, WET_ADC, 0, 100);
    moisture = constrain(moisture, 0, 100);

    temperature = dht.readTemperature();
    humidity = dht.readHumidity();
    dhtValid = !isnan(temperature) && !isnan(humidity);

    Serial.println("\n----- SENSOR READINGS -----");
    printSensorInfo();

    // Automatic irrigation (only when AUTO was typed)
    if (automaticMode && !flowFault)
    {
      if (moisture < MOISTURE_LOW && !pumpOn)
      {
        Serial.println("Soil is dry. Starting irrigation.");
        setPump(true);
      }

      if (moisture >= MOISTURE_TARGET && pumpOn)
      {
        Serial.println("Target moisture reached.");
        setPump(false);
      }

      if (moisture >= WET_LIMIT && pumpOn)
      {
        Serial.println("Soil is very wet. Stopping pump.");
        setPump(false);
      }
    }

    Serial.print("Mode: ");
    Serial.println(automaticMode ? "AUTO" : "MANUAL");
    printRelayInfo();
  }

#if USE_FLOW_SENSOR
  // ---- Water flow monitoring ----
  if (now - lastFlowCheck >= FLOW_INTERVAL)
  {
    unsigned long previousCheck = lastFlowCheck;

    noInterrupts();
    unsigned long pulses = flowPulses;
    flowPulses = 0;
    interrupts();

    float seconds = (now - previousCheck) / 1000.0;

    if (seconds > 0)
      flowRate = (pulses / PULSES_PER_LITRE) * (60.0 / seconds);

    totalLitres += pulses / PULSES_PER_LITRE;
    lastFlowCheck = now;

    // Safety: stop pump if no flow is detected
    if (pumpOn && now - pumpStartTime >= FLOW_TIMEOUT && flowRate < 0.1)
    {
      flowFault = true;
      Serial.println("FLOW FAULT: No water flow detected!");
      setPump(false);
    }
  }
#endif
}
